# Working arsenal dirs are populated by resources/fetch-resources.sh (online) or
# unpacked from vendor/ (offline). Don't commit the loose files — the vendored
# snapshot (vendor/arsenal.tgz, tracked below) is how the arsenal rides into the
# air-gapped box via git.
resources/bin/*
resources/linux/*
resources/windows/*
resources/webshells/*
resources/data/*
!resources/**/.gitkeep

# ...but DO track the vendored snapshot the competition box clones.
!vendor/
!vendor/arsenal.tgz

# backups the installer makes
*.curtain-call.bak

# No AI/assistant notes or identifying metadata in the repo (competition rules)
.claude/
CLAUDE.md
claude-notes/
*.claude.md
.DS_Store

